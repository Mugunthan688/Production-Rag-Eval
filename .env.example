# ============================================================
# Production-Grade RAG System — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your API keys.
# At minimum, provide ONE LLM API key (Gemini recommended).
# ============================================================

# ──────────────────── Database ────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=rag_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/rag_db

# ──────────────────── LLM API Keys ────────────────────
# Provide at least ONE key. Gemini has a generous free tier.
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ──────────────────── Provider Config ────────────────────
EMBEDDING_PROVIDER=local          # local (BGE) or openai
EMBEDDING_MODEL=text-embedding-3-small
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
LLM_PROVIDER=gemini               # gemini, openai, or anthropic
LLM_MODEL=gemini-flash-latest

# ──────────────────── Pipeline Config ────────────────────
DEFAULT_CHUNKING_STRATEGY=recursive   # fixed, recursive, or semantic
CHUNK_SIZE=500
CHUNK_OVERLAP=50
HYBRID_SEARCH_ENABLED=true
RERANKER_ENABLED=true
QUERY_REWRITING_ENABLED=true

# ──────────────────── Operational ────────────────────
LOG_LEVEL=INFO
APP_PORT=8000
STREAMLIT_PORT=8501
